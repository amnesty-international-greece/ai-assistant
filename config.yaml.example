# AI Assistant Platform - example configuration
# Copy this file to config.yaml and fill in your values.
# Secrets (API keys, tokens) go in .env - see .env.example.

app:
  name: "AI Assistant Platform"
  version: "0.1.0"

llm:
  max_retries: 4                  # transient provider errors are retried
  retry_base_seconds: 5.0         # first backoff, then doubling
  provider: "gemini"              # "gemini" (free, prototyping) | "claude" (production)
  model: "gemini-2.0-flash"       # switch to "claude-sonnet-4-20250514" for production
  max_tokens: 4096
  temperature: 0.3

claude:
  model: "claude-sonnet-4-20250514"
  max_tokens: 4096
  temperature: 0.3

storage:
  database_path: "data/amnesty.db"
  prompts_dir: "src/prompts"

onedrive:
  sharepoint_host: "yourorg.sharepoint.com"
  sharepoint_site_path: "/sites/Board"
  archive_root: "Αρχείο"
  yearly_subfolder: "Αρχείο ανά έτος"
  protocol_excel: "[Πρωτόκολλο] Αρχείο ΔΣ.xlsx"
  archiving_guide: "Σύστημα Αρχειοθέτησης.docx"

google:
  templates_folder_id: ""         # Google Drive folder ID for document templates
  decisions_sheet_id: ""          # Βιβλίο Αποφάσεων ΔΣ spreadsheet ID
  agenda_sheet_id: ""             # Meeting agenda spreadsheet ID
  invitation_template_id: ""      # [Πρότυπο] Πρόσκληση Google Doc ID
  minutes_drafts_folder_id: ""    # Google Drive folder with SecGen's draft notes

zoom:
  meeting_defaults:
    duration: 120                 # minutes
    timezone: "Europe/Athens"

crabfit:
  # Free, open-source When2Meet-style availability grid used as the scheduling
  # poll.  Defaults to the public hosted instance; point at a self-hosted
  # Crab Fit later by changing these.
  api_base: "https://api.crab.fit"
  web_base: "https://crab.fit"
  default_start_hour: 9           # local-time start of the daily availability window
  default_end_hour: 23            # exclusive end (last slot is 22:45)

brevo:
  sender_email: "members@yourorg.gr"
  sender_name: "Your Organisation Name"
  newsletter_template_id: 0       # Brevo template ID for board meeting invitations
  master_list_id: 0               # Brevo master contact list ID (fallback)

  contact_lists:
    master: 0                     # Master membership list (do not send newsletters directly)

  segments:
    regular_members:   0          # Τακτικά Μέλη - receive board-meeting newsletters
    candidate_members: 0          # Υποψήφια Μέλη - welcome email + onboarding only
    youth_members:     0          # Νέοι/Νέες - youth-specific newsletters

  # Brevo keeps LISTS and SEGMENTS in separate ID spaces. Put each id under the
  # right key; `python -m src.cli invite check` verifies them.
  newsletter_list_ids: []         # Brevo LIST ids to receive board meeting invitations
  newsletter_segment_ids: []      # Brevo SEGMENT ids to receive board meeting invitations
  # Named ids, so an audience can be referred to by name rather than a number.
  contact_lists: {}               # e.g. {member_register: 82}
  segments: {}                    # e.g. {regular_members: 1, youth_members: 5}
  invitation_newsletter: true     # false = invitations go out without the member newsletter

discord:
  channels:
    announcements: ""             # Channel ID for announcements
    verification: ""              # Channel ID for member verification
    events_channel_id: ""         # Forum channel for public events
  email_gateway:
    gmail_user: ""                # Gmail address for the email↔Discord bridge
    google_group_email: ""        # Google Group email address
    imap_host: "imap.gmail.com"
    imap_port: 993
    smtp_host: "smtp.gmail.com"
    smtp_port: 587
    poll_interval_seconds: 60
    max_attachment_mb: 5
  classifier:
    enabled: true
    confidence_threshold: 0.70
    temperature: 0.1
    uncertain_label: "UNCERTAIN"
  admin:
    admin_channel_id: ""          # Admin-only channel for bot status/logs
    test_admin_channel_id: ""     # Test channel for dev runs
  stats:
    weekly_post_day: 6            # Sunday (0=Monday … 6=Sunday)
    weekly_post_hour: 0           # midnight local time
  teams:
    coordinator_role_id: ""       # Discord role ID for Συντονιστής
  platform_bridge:
    board_meeting:
      agenda_channel_id: ""       # Public forum channel - members-visible agenda threads
      agenda_channel_id_test: ""  # Sandbox channel for --test runs
      board_channel_id: ""        # Private board forum channel
      agenda_forum_tag_name: "Συνεδριάσεις"  # tag applied to public forum threads
      board_channel_id_test: ""   # Sandbox channel for --test runs
      board_role_id: ""           # Discord role ID gating /archive and right-click archive
      reminder_hours_before: 6

workflows:
  board_meeting:
    reminder_hours_before: 3
    min_notice_days: 7
    max_advance_days: 14
    minutes_share_message: "Σας κοινοποιούνται τα πρόχειρα πρακτικά προς σχολιασμό. Παρακαλώ αφήστε τα σχόλιά σας απευθείας στο έγγραφο."
    # Add one entry per board member. Each receives a personal Zoom join link.
    board_members:
      - email: "chair@yourorg.gr"
        first_name: "Πρόεδρος"
        last_name: "Επώνυμο"
      - email: "secgen@yourorg.gr"
        first_name: "Γεν. Γραμματέας"
        last_name: "Επώνυμο"
      # Add remaining board members here...
  general_assembly:
    min_notice_days: 30
    min_electronic_notice_days: 15

# ── M365 inbox watcher ────────────────────────────────────────────────────────
m365_inbox:
  subject_patterns:
    - "αρχειο"
    - "archive"
  sender_allow_list: []           # empty → defaults to all board_members
  webhook_url: ""                 # public Cloudflare Tunnel URL, e.g. https://tunnel.example.com
  subscription_lifetime_minutes: 4230
  renew_threshold_hours: 24
  safety_poll_hour: 12
  safety_poll_minute: 0

# ── Minutes pipeline ──────────────────────────────────────────────────────────
minutes_pipeline:
  transcriber: "faster_whisper"   # "faster_whisper" | "fake" (no-ASR stub for testing)
  whisper_model: "large-v3"       # model size: tiny / base / small / medium / large-v3
  whisper_device: "cpu"           # "cpu" | "cuda"
  whisper_compute_type: "int8"    # "int8" (CPU-friendly) | "float16" (GPU)
  whisper_vad_filter: true            # skip silence (big speedup) + stops hallucination on silence
  whisper_vad_min_silence_ms: 1000    # min silence (ms) before VAD splits a speech chunk
  whisper_beam_size: 5                # decoding beam width
  whisper_cpu_threads: 8              # 0 = auto; set to your CPU core count
  whisper_condition_on_previous_text: false  # OFF: main cause of Whisper repetition loops
  whisper_chunk_seconds: 1800         # split long tracks into ~30-min pieces (VAD runs out of memory on 5h tracks); 0 = off
  whisper_piece_cache: true           # save each finished piece (transcripts_dir/_asr_cache) so reruns resume
  language: "el"                  # ASR + drafting language
  coalesce_max_gap_seconds: 30.0  # merge consecutive same-speaker fragments (<= gap) into one turn; -1 disables
  draft_item_char_budget: 120000  # max chars of one agenda item's transcript sent to the drafting LLM (avoids truncating long items)
  draft_max_output_tokens: 32000      # output ceiling per drafting call (Greek is token-expensive)
  draft_block_chars: 12000           # transcript chars per drafting call; long items are split
  draft_min_speaker_coverage: 0.5    # lenient floor; below it a block is retried once
  organizer_enabled: true            # LLM re-files ambiguous turns under the right agenda item + tags them
  organizer_max_tokens: 8000         # output ceiling per organiser call
  organizer_island_max_turns: 8      # an isolated run of turns this short is re-checked
  organizer_island_gap_seconds: 180.0  # ... when the silence around it is at least this long
  director_briefings_dir: "data/director_briefings"  # where briefing notes are kept
  glossary_extra: []              # extra terms to prime ASR (names, English words spoken in Greek)
  organizer_batch_turns: 40          # turns per organiser call
  organizer_text_limit: 600          # chars of each turn shown to the organiser
  organizer_context_turns: 8         # previous turns shown read-only to each organiser batch
  organizer_island_review: true      # re-check short runs filed inside another item stretch
  recordings_dir: "data/recordings"
  transcripts_dir: "data/transcripts"
  articles_path: "assets/governance/articles.json"
  # Map each board member's Zoom display name to their canonical roster name.
  speaker_aliases:
    "Display Name in Zoom": "Κανονικό Όνομα"

# ── Public-facing URLs ────────────────────────────────────────────────────────
urls:
  katastatiko: ""                 # Link to your Καταστατικό (e.g. Google Drive share link)
  esoterikoi_kanonismoi: ""       # Link to your Εσωτερικοί Κανονισμοί
  website: "https://www.yourorg.gr"

# ── Role mailboxes ────────────────────────────────────────────────────────────
# One address per ROLE, not per person: they survive elections.
roles:
  board: "board@yourorg.gr"
  director: "director@yourorg.gr"
  secgen: "secgen@yourorg.gr"
  members: "members@yourorg.gr"


# ── Backups ───────────────────────────────────────────────────────────────────
# A copy of data/amnesty.db is written nightly at 03:30 Europe/Athens while the
# server runs, or on demand with: python -m src.cli backup now
backup:
  keep: 14                       # nightly copies kept on this machine


# ── Retention (GDPR) ──────────────────────────────────────────────────────────
# Recordings and transcripts are the most sensitive data here. FOUNDATION.md
# 3.1: kept until the minutes are finalised, then deleted. Board-confirmed
# 2026-09-21. Check with: python -m src.cli retention report
retention:
  grace_days: 14                 # kept this long after the minutes are finalised
  max_age_days: 365              # deleted at this age even if minutes never were


# ── Test mode ─────────────────────────────────────────────────────────────────
testing:
  test_email: ""                  # Redirect all outbound emails here during --test runs
